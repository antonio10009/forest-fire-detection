# Copia este archivo como backend/.env para correr el servidor en tu PC.
# En Render van las mismas variables, en Environment.
# El .env real tiene claves: nunca lo subas a GitHub ni lo compartas.

DATABASE_URL=postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require

# Claves propias del sistema: inventa dos textos largos y distintos
DEVICE_API_KEY=cambia-esto
ADMIN_API_KEY=cambia-esto-tambien

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_MSG_SVC_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Solo si no usas Messaging Service:
# TWILIO_FROM_WA=whatsapp:+14155238886
TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CONTENT_SID_TECNICO=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AVISOS_TECNICOS_WA=+569XXXXXXXX,+569YYYYYYYY

# Opcionales
# MINUTOS_SIN_SENAL=10
# BATERIA_BAJA_MV=3400
# PERMITIR_LECTURA_SIN_CLAVE=1
